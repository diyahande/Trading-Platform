# E2E Test Environment Variables

# Frontend base URL
E2E_BASE_URL=http://localhost:4200
E2E_FRONTEND_BASE_URL=http://localhost:4200

# Backend service URLs (optional, for direct API testing if needed)
E2E_AUTH_API=http://localhost:3000
E2E_TRADE_API=http://localhost:8083

# Test credentials - primary user (Alice with $15,000 account)
E2E_USERNAME=alice.johnson@example.com
E2E_PASSWORD=Test@1234567
E2E_ACCOUNT_ID=11111111-1111-4111-8111-111111111111

# Test credentials - secondary user for testing (Bob with $25 account)
E2E_BOB_USERNAME=bob.smith@example.com
E2E_BOB_PASSWORD=Test@1234567
E2E_BOB_ACCOUNT_ID=22222222-2222-4222-8222-222222222222

# Test symbol for order placement (from seeded instruments)
E2E_SYMBOL=AAPL

# Optional: specific protected path to test for sign-in return URL
E2E_PROTECTED_PATH=/dashboard

# Invalid credentials for testing refused sign-in
E2E_INVALID_USERNAME=invalid@example.com
E2E_INVALID_PASSWORD=InvalidPassword123456
